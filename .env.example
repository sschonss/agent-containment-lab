# Optional live credential probe. Leave these empty for the offline mock.
# Never commit a real token. Never put a real token in workspace/.env.
# LAB_GITHUB_PAT wins over GITHUB_TOKEN. The live probe targets GITHUB_REPO,
# or sschonss/agent-containment-lab when GITHUB_REPO is empty.
LAB_GITHUB_PAT=
GITHUB_TOKEN=
GITHUB_REPO=
# mock | live. Empty means: live when a token is set, mock otherwise.
CREDENTIAL_MODE=
# Ollama model used by `make llm`. The default is the one `make prepull` downloads.
OLLAMA_MODEL=qwen2.5:3b
PRINCIPAL_ID=schons
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
